const statusChip = id => { const s = statusOf(id); return `<span class="st st-${s.k}">${s.t}</span>`; };
const avatarHtml = (u, cls='av') => u && u.avatar ? `<img class="${cls}" src="${u.avatar}" alt="头像">` : `<span class="${cls} av-ph">${esc((u ? u.username : '客')[0])}</span>`;

