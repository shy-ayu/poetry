const dstr = (d=new Date()) => `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
const addDays = (s, n) => { const d = new Date(s+'T00:00:00'); d.setDate(d.getDate()+n); return dstr(d); };
const diffDays = (a, b) => Math.round((new Date(b+'T00:00:00') - new Date(a+'T00:00:00'))/864e5);
const today = () => dstr();
const strip = s => s.replace(/[\s，。、；：！？“”‘’《》（）()「」『』…—·,.;:!?'"]/g, '');
const clauses = t => t.match(/[^，、；：。！？]+[，、；：。！？”’]*/g) || [t];

/* --- 存储（localStorage，失败时退回内存） --- */
const mem = {};
const Store = {
  get(k, def=null){ try { const v = localStorage.getItem(k); return v==null ? (k in mem ? mem[k] : def) : JSON.parse(v); } catch(e){ return k in mem ? mem[k] : def; } },
  set(k, v){ mem[k] = v; try { localStorage.setItem(k, JSON.stringify(v)); } catch(e){} },
  del(k){ delete mem[k]; try { localStorage.removeItem(k); } catch(e){} }
};

/* --- 数据 --- */
const PIECES = (window.PIECES || []).slice();
const byId = {}; PIECES.forEach(p => byId[p.id] = p);
function allPieces(){ return PIECES.concat(Session.data ? Session.data.custom.map(c => c) : []); }
function getPiece(id){ return byId[id] || (Session.data && Session.data.custom.find(c => c.id===id)); }
function gradeOf(vol){ return GRADES.find(g => g.vols.includes(vol)); }
function piecesOfGrade(gid){
  const g = GRADES.find(x => x.id===gid);
  const list = allPieces();
  if (!g) return list;
  return list.filter(p => g.vols.includes(p.volume));
}

/* --- 账户 / 会话 --- */
let HASH = (location.hash || '#/home');
const Session = { user:null, data:null, minutesTick:null };
const newData = () => ({ progress:{}, log:{}, wrong:{}, custom:[], settings:{ grade:'g7', goalQ:20, goalMin:15, focus:'both', targetDate:'', goalNote:'', recitePref:'cloze' } });
function dataKey(email){ return 'shici.data.' + (email || '__guest__'); }
function loadData(email){
  const d = Store.get(dataKey(email));
  const base = newData();
  if (!d) return base;
  d.settings = Object.assign(base.settings, d.settings || {});
  for (const k of ['progress','log','wrong']) d[k] = d[k] || {};
  d.custom = d.custom || [];
  return d;
}
function saveData(){ if (Session.data) Store.set(dataKey(Session.user && Session.user.email), Session.data); }
const users = () => Store.get('shici.users', {});
const saveUsers = u => Store.set('shici.users', u);

async function hashPw(pw, salt){
  try {
    const enc = new TextEncoder();
    const key = await crypto.subtle.importKey('raw', enc.encode(pw), 'PBKDF2', false, ['deriveBits']);
    const bits = await crypto.subtle.deriveBits({name:'PBKDF2', salt:enc.encode(salt), iterations:60000, hash:'SHA-256'}, key, 256);
    return [...new Uint8Array(bits)].map(b => b.toString(16).padStart(2,'0')).join('');
  } catch(e){
    let h = 5381; const s = salt + pw; for (let i=0;i<s.length;i++) h = ((h<<5)+h) ^ s.charCodeAt(i);
    return 'x' + (h>>>0).toString(16);
  }
}
const randSalt = () => Math.random().toString(36).slice(2) + Date.now().toString(36);
const validEmail = e => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e);

const Auth = {
  async register(email, username, pw){
    email = email.trim().toLowerCase();
    if (!validEmail(email)) throw '请输入有效的邮箱地址';
    username = (username || '').trim() || email.split('@')[0];
    if (pw.length < 6) throw '密码至少 6 位';
    const u = users();
    if (u[email]) throw '该邮箱已注册，请直接登录';
    const salt = randSalt();
    u[email] = { email, username: username.trim(), salt, hash: await hashPw(pw, salt), avatar:'', created: today() };
    saveUsers(u);
    // 把游客期间的进度带入新账户
    const guest = Store.get(dataKey(null));
    if (guest) Store.set(dataKey(email), guest);
    await Auth.login(email, pw);
  },
  async login(email, pw){
    email = email.trim().toLowerCase();
    const u = users()[email];
    if (!u) throw '账号不存在';
    if (u.hash !== await hashPw(pw, u.salt)) throw '密码不正确';
    Store.set('shici.session', email);
    Session.user = u; Session.data = loadData(email);
  },
  logout(){ saveData(); Store.del('shici.session'); Session.user = null; Session.data = loadData(null); },
  restore(){
    const email = Store.get('shici.session');
    const u = email && users()[email];
    Session.user = u || null; Session.data = loadData(u ? u.email : null);
  },
  updateProfile(patch){ const us = users(); Object.assign(us[Session.user.email], patch); saveUsers(us); Session.user = us[Session.user.email]; },
  async changePassword(oldPw, newPw){
    if (newPw.length < 6) throw '新密码至少 6 位';
    const us = users(), u = us[Session.user.email];
    if (u.hash !== await hashPw(oldPw, u.salt)) throw '当前密码不正确';
    u.salt = randSalt(); u.hash = await hashPw(newPw, u.salt); saveUsers(us); Session.user = u;
  },
  async changeEmail(newEmail, pw){
    newEmail = newEmail.trim().toLowerCase();
    if (!validEmail(newEmail)) throw '邮箱格式不正确';
    const us = users(), old = Session.user.email, u = us[old];
    if (newEmail === old) return;
    if (us[newEmail]) throw '该邮箱已被注册';
    if (u.hash !== await hashPw(pw, u.salt)) throw '密码不正确';
    saveData(); delete us[old]; u.email = newEmail; us[newEmail] = u; saveUsers(us);
    Store.set(dataKey(newEmail), Session.data); Store.del(dataKey(old)); Store.set('shici.session', newEmail); Session.user = u;
  },
  deleteAccount(){ const us = users(); delete us[Session.user.email]; saveUsers(us); Store.del(dataKey(Session.user.email)); Store.del('shici.session'); Session.user=null; Session.data = loadData(null); }
};

/* --- 学习进度 / 复习（间隔重复） --- */
function prog(id){ return Session.data.progress[id]; }
function ensureProg(id){
  const P = Session.data.progress;
  if (!P[id]) P[id] = { box:0, due:null, first:today(), last:null, reps:0, lapses:0, scores:[], studied:false };
  return P[id];
}
function statusOf(id){
  const p = prog(id);
  if (!p || !p.studied) return {k:'new', t:'未学'};
  if (p.box >= 6) return {k:'mastered', t:'已掌握'};
  if (p.box >= 3) return {k:'review', t:'复习中'};
  return {k:'learning', t:'学习中'};
}
function isDue(id){ const p = prog(id); return !!(p && p.studied && p.due && p.due <= today()); }
function dueList(){ return allPieces().filter(p => isDue(p.id)).sort((a,b) => prog(a.id).due.localeCompare(prog(b.id).due)); }

function dayLog(d=today()){
  const L = Session.data.log;
  if (!L[d]) L[d] = { q:0, ok:0, sec:0, pieces:[], acts:[] };
  return L[d];
}
function addActivity(pieceId, act, ok, total){
  const l = dayLog();
  l.q += total; l.ok += ok;
  if (pieceId && !l.pieces.includes(pieceId)) l.pieces.push(pieceId);
  l.acts.push({ id:pieceId, act, ok, n:total, t:new Date().toTimeString().slice(0,5) });
  saveData();
}
/* 学习/练习结束后更新该篇的间隔复习：score∈[0,1] */
function applyReview(id, score, act){
  const p = ensureProg(id);
  p.studied = true; p.reps++; p.last = today();
  p.scores.push({ d:today(), s:Math.round(score*100), a:act });
  if (p.scores.length > 60) p.scores.shift();
  if (p.box === 0) p.box = score >= 0.6 ? 1 : 1;
  else if (score >= 0.85) p.box = Math.min(BOX_DAYS.length-1, p.box+1);
  else if (score < 0.6){ p.box = Math.max(1, p.box-2); p.lapses++; }
  p.due = addDays(today(), BOX_DAYS[p.box]);
  saveData();
}
function recordWrong(pieceId, u, kind){
  const key = pieceId + '#' + u + '#' + kind;
  const w = Session.data.wrong;
  w[key] = w[key] || { id:pieceId, u, kind, n:0, last:null };
  w[key].n++; w[key].last = today();
}
function clearWrong(pieceId, u, kind){
  const key = pieceId + '#' + u + '#' + kind; const w = Session.data.wrong;
  if (w[key]){ w[key].n--; if (w[key].n <= 0) delete w[key]; }
}
function streak(){
  const L = Session.data.log; let s = 0, d = today();
  if (!(L[d] && L[d].q+L[d].sec > 0)) d = addDays(d, -1);
  while (L[d] && (L[d].q > 0 || L[d].sec > 60)){ s++; d = addDays(d, -1); }
  return s;
}
function totals(){
  const L = Session.data.log; let q=0, ok=0, sec=0, days=0;
  for (const d in L){ q+=L[d].q; ok+=L[d].ok; sec+=L[d].sec; if (L[d].q || L[d].sec>60) days++; }
  return { q, ok, sec, days };
}
/* 用时统计：页面可见时每 10 秒累计 */
function startTimer(){
  clearInterval(Session.minutesTick);
  Session.minutesTick = setInterval(() => {
    if (document.hidden || !Session.data) return;
    dayLog().sec += 10; if (Math.random() < .3) saveData();
  }, 10000);
  window.addEventListener('beforeunload', saveData);
}

/* ===== quiz: 题目生成 + 答题引擎 ===== */
const TYPE_NAMES = { mcq:'选择题', type:'默写', fill:'填空', order:'排序', self:'赏析' };
const reciteUnits = p => p.units.map((x,i)=>({...x,i})).filter(x => x.r !== 0);

function otherPieces(p, kind){ return allPieces().filter(x => x.id !== p.id && (!kind || x.kind === kind)); }

/* —— 解析题 —— */
function genWord(p){
  const out = [];
  for (const n of p.notes || []){
    if (!(n.d && n.d.length >= 2)) continue;
    const opts = shuffle([n.m, n.d[0], n.d[1]]);
    out.push({ type:'mcq', piece:p.id, u:n.u, kind:'word', cat:'字词释义',
      prompt:`《${esc(p.title)}》中，“${esc(p.units[n.u].t)}”一句里，加点词 <b class="hl">${esc(n.w)}</b> 的意思是？`,
      options:opts, ans:opts.indexOf(n.m), explain:`${n.w}：${n.m}（${n.t}）` });
  }
  return out;
}
function genTrans(p){
  const out = [];
  const pool = p.units.filter(u => u.tr);
  if (pool.length < 2) return out;
  for (let i=0;i<p.units.length;i++){
    const u = p.units[i]; if (!u.tr) continue;
    let wrong = shuffle(pool.filter(x => x !== u).map(x => x.tr));
    if (wrong.length < 3) wrong = wrong.concat(pick(otherPieces(p).flatMap(o => o.units.filter(x=>x.tr).map(x=>x.tr)), 3));
    wrong = uniq(wrong).slice(0,3); if (wrong.length < 3) continue;
    const opts = shuffle([u.tr, ...wrong]);
    out.push({ type:'mcq', piece:p.id, u:i, kind:'trans', cat:'句子翻译',
      prompt:`《${esc(p.title)}》中，“${esc(u.t)}”的正确翻译是？`, options:opts, ans:opts.indexOf(u.tr), explain:`译文：${u.tr}` });
  }
  return out;
}
function genMeta(p){
  const out = [];
  const authors = uniq(otherPieces(p).map(o => o.author).filter(a => a && a !== p.author));
  if (authors.length >= 3){
    const opts = shuffle([p.author, ...pick(authors,3)]);
    out.push({ type:'mcq', piece:p.id, u:-1, kind:'author', cat:'文学常识', prompt:`《${esc(p.title)}》的作者是？`, options:opts, ans:opts.indexOf(p.author), explain:`${p.dynasty}·${p.author}` });
  }
  const themes = uniq(otherPieces(p, p.kind).map(o => o.theme).filter(t => t && t !== p.theme));
  if (p.theme && themes.length >= 3){
    const opts = shuffle([p.theme, ...pick(themes,3)]);
    out.push({ type:'mcq', piece:p.id, u:-1, kind:'theme', cat:'主旨情感', prompt:`下列对《${esc(p.title)}》主旨或情感的概括，最恰当的是？`, options:opts, ans:opts.indexOf(p.theme), explain:p.theme });
  }
  return out;
}
function genAppr(p){
  return (p.appr || []).map((a,i) => ({ type:'self', piece:p.id, u:-1-i, kind:'appr', cat:'赏析题', prompt:`《${esc(p.title)}》：${esc(a.q)}`, reference:a.a }));
}
/* —— 背诵题 —— */
function genDict(p){
  const out = [], R = reciteUnits(p);
  R.forEach(x => {
    const c = clauses(x.t);
    if (c.length >= 2){
      out.push({ type:'type', piece:p.id, u:x.i, kind:'dict', cat:'默写',
        prompt:`《${esc(p.title)}》默写：“<b>${esc(c[0])}</b>”的后文是：`, answer:c.slice(1).join(''), full:x.t, tricky:p.tricky });
    } else {
      const prev = x.i > 0 ? p.units[x.i-1].t : null;
      out.push({ type:'type', piece:p.id, u:x.i, kind:'dict', cat:'默写',
        prompt: prev ? `《${esc(p.title)}》默写：“<b>${esc(prev)}</b>”的下一句是：` : `《${esc(p.title)}》（${esc(p.author)}）第一句是：`,
        answer:x.t, full:x.t, tricky:p.tricky });
    }
  });
  return out;
}
function genKey(p){
  return (p.keyLines || []).map(k => ({ type:'type', piece:p.id, u:k.u, kind:'key', cat:'理解性默写',
    prompt:`《${esc(p.title)}》理解性默写：${esc(k.hint)}`, answer:p.units[k.u].t, full:p.units[k.u].t, tricky:p.tricky }));
}
function genFill(p){
  const out = [], R = reciteUnits(p);
  R.forEach(x => {
    const chars = [...x.t]; const isC = c => /[一-鿿]/.test(c);
    const idxs = chars.map((c,i)=>i).filter(i => isC(chars[i]));
    if (idxs.length < 4) return;
    const trick = idxs.filter(i => (p.tricky||[]).includes(chars[i]));
    const n = Math.min(Math.max(1, Math.round(idxs.length/6)), 3);
    const mask = new Set(shuffle(trick).slice(0,n));
    shuffle(idxs).forEach(i => { if (mask.size < n) mask.add(i); });
    out.push({ type:'fill', piece:p.id, u:x.i, kind:'fill', cat:'填空', chars, mask:[...mask].sort((a,b)=>a-b),
      prompt:`《${esc(p.title)}》补全诗文（在空格里填入缺的字）：`, full:x.t });
  });
  return out;
}
function genOrder(p){
  const R = reciteUnits(p); const out = [];
  if (R.length < 3) return out;
  for (let s = 0; s + 3 <= R.length && out.length < 3; s += Math.max(3, Math.floor(R.length/3))){
    const seg = R.slice(s, s + Math.min(4, R.length - s)); if (seg.length < 3) break;
    out.push({ type:'order', piece:p.id, u:seg[0].i, kind:'order', cat:'句序排列', prompt:`《${esc(p.title)}》把下面的句子按原文顺序排好：`, items:shuffle(seg.map(x => x.t)), correct:seg.map(x => x.t) });
  }
  return out;
}
const GENS = { word:genWord, trans:genTrans, meta:genMeta, appr:genAppr, dict:genDict, key:genKey, fill:genFill, order:genOrder };
const QSETS = {
  analyze: { name:'解析题', gens:['word','trans','meta','appr'] },
  recite:  { name:'背诵题', gens:['dict','key','fill','order'] },
  mixed:   { name:'综合', gens:['word','trans','dict','key','fill','order','meta'] },
};
function buildQuestions(pieces, set, count){
  const gens = Array.isArray(set) ? set : QSETS[set].gens;
  let qs = [];
  pieces.forEach(p => gens.forEach(g => { try { qs = qs.concat(GENS[g](p)); } catch(e){ console.warn(e); } }));
  qs = shuffle(qs);
  return count ? qs.slice(0, count) : qs;
}

/* —— 默写比对：对齐后标出错字 —— */
function alignDiff(user, ans){
  const a = [...strip(user)], b = [...strip(ans)];
  const n = a.length, m = b.length;
  const dp = Array.from({length:n+1}, () => new Array(m+1).fill(0));
  for (let i=1;i<=n;i++) for (let j=1;j<=m;j++) dp[i][j] = a[i-1]===b[j-1] ? dp[i-1][j-1]+1 : Math.max(dp[i-1][j], dp[i][j-1]);
  const hit = new Array(m).fill(false); let i=n, j=m;
  while (i>0 && j>0){ if (a[i-1]===b[j-1]){ hit[j-1]=true; i--; j--; } else if (dp[i-1][j] >= dp[i][j-1]) i--; else j--; }
  return { b, hit, same: a.join('')===b.join('') };
}
function diffHtml(user, ans){
  const d = alignDiff(user, ans);
  return d.b.map((c,k) => `<span class="${d.hit[k]?'ok':'bad'}">${esc(c)}</span>`).join('');
}

/* —— 答题引擎 —— */
function runQuiz(root, questions, opts={}){
  const state = { i:0, res:[], startedAt:Date.now() };
  const total = questions.length;
  if (!total){ root.innerHTML = `<div class="empty">没有可用的题目。换个范围试试，或先学习篇目。</div>`; return; }
  function show(){
    if (state.i >= total) return finish();
    const q = questions[state.i];
    root.innerHTML = `
      <div class="quiz-head"><span class="chip">${esc(q.cat)}</span><span class="muted">${state.i+1} / ${total}</span>
        <div class="bar"><i style="width:${state.i/total*100}%"></i></div></div>
      <div class="q-prompt">${q.prompt}</div><div class="q-body"></div><div class="q-fb"></div><div class="q-actions"></div>`;
    const body = $('.q-body', root), fb = $('.q-fb', root), act = $('.q-actions', root);
    let done = false;
    const complete = (ok, html) => {
      if (done) return; done = true;
      state.res.push({ q, ok });
      fb.innerHTML = `<div class="fb ${ok?'good':'badfb'}"><b>${ok?'✓ 正确':'✗ 再记一记'}</b>${html||''}</div>`;
      act.innerHTML = `<button class="btn primary" id="next">${state.i+1>=total?'查看结果':'下一题'} →</button>`;
      const nb = $('#next', root); nb.focus(); nb.onclick = () => { state.i++; show(); };
    };
    if (q.type === 'mcq'){
      body.innerHTML = q.options.map((o,k) => `<button class="opt" data-k="${k}"><span class="k">${'ABCD'[k]}</span>${esc(o)}</button>`).join('');
      $$('.opt', body).forEach(b => b.onclick = () => {
        if (done) return; const k = +b.dataset.k;
        $$('.opt', body).forEach((x,j) => { x.disabled = true; if (j===q.ans) x.classList.add('right'); });
        if (k !== q.ans) b.classList.add('wrong');
        complete(k === q.ans, `<div class="explain">${esc(q.explain||'')}</div>`);
      });
    } else if (q.type === 'type'){
      body.innerHTML = `<textarea class="ans" rows="2" placeholder="在这里默写（标点可省略）" autofocus></textarea>
        <div class="row"><button class="btn" id="hint">提示首字</button><button class="btn primary" id="chk">提交</button><button class="btn ghost" id="giveup">不会</button></div>`;
      const ta = $('textarea', body); ta.focus();
      $('#hint', body).onclick = () => { ta.placeholder = '首字：' + strip(q.answer)[0] + '…（共 ' + strip(q.answer).length + ' 字）'; };
      const check = giveup => {
        const val = giveup ? '' : ta.value; ta.disabled = true;
        const d = alignDiff(val, q.answer);
        const wrongChars = d.b.filter((c,k)=>!d.hit[k]);
        const tip = wrongChars.length && q.tricky ? wrongChars.filter(c => q.tricky.includes(c)).map(c => `“${c}”是易错字`).join('，') : '';
        complete(d.same, `<div class="diff">${diffHtml(val, q.answer)}</div><div class="explain">原文：${esc(q.full)}${tip?'<br>'+esc(tip):''}</div>`);
      };
      $('#chk', body).onclick = () => check(false); $('#giveup', body).onclick = () => check(true);
      ta.addEventListener('keydown', e => { if (e.key==='Enter' && !e.shiftKey){ e.preventDefault(); if(!done) check(false); } });
    } else if (q.type === 'fill'){
      let html = ''; q.chars.forEach((c,k) => { html += q.mask.includes(k) ? `<input class="blank" maxlength="1" data-k="${k}" aria-label="空格">` : `<span class="ch">${esc(c)}</span>`; });
      body.innerHTML = `<div class="fill">${html}</div><div class="row"><button class="btn primary" id="chk">提交</button><button class="btn ghost" id="giveup">不会</button></div>`;
      const ins = $$('.blank', body); ins[0] && ins[0].focus();
      ins.forEach((inp,ix) => inp.addEventListener('input', () => { if (inp.value && ins[ix+1]) ins[ix+1].focus(); }));
      const check = giveup => {
        let ok = true;
        ins.forEach(inp => { const right = q.chars[+inp.dataset.k]; const good = !giveup && inp.value.trim() === right; if (!good) ok = false; inp.classList.add(good?'right':'wrong'); inp.disabled = true; if (!good) inp.value = right; });
        complete(ok, `<div class="explain">原文：${esc(q.full)}</div>`);
      };
      $('#chk', body).onclick = () => check(false); $('#giveup', body).onclick = () => check(true);
      body.addEventListener('keydown', e => { if (e.key==='Enter' && !done) check(false); });
    } else if (q.type === 'order'){
      let chosen = [];
      const draw = () => {
        body.innerHTML = `<div class="order-chosen">${chosen.map(c => `<span class="chip big">${esc(c)}</span>`).join('') || '<span class="muted">依次点击下面的句子</span>'}</div>
          <div class="order-pool">${q.items.map((it,k) => `<button class="opt ${chosen.includes(it)?'used':''}" data-k="${k}" ${chosen.includes(it)?'disabled':''}>${esc(it)}</button>`).join('')}</div>
          <div class="row"><button class="btn" id="reset">重选</button><button class="btn primary" id="chk" ${chosen.length<q.items.length?'disabled':''}>提交</button></div>`;
        $$('.opt', body).forEach(b => b.onclick = () => { chosen.push(q.items[+b.dataset.k]); draw(); });
        $('#reset', body).onclick = () => { chosen = []; draw(); };
        $('#chk', body).onclick = () => { const ok = chosen.join('|') === q.correct.join('|'); $$('button', body).forEach(b => b.disabled = true); complete(ok, `<div class="explain">正确顺序：<br>${q.correct.map(esc).join('<br>')}</div>`); };
      };
      draw();
    } else if (q.type === 'self'){
      body.innerHTML = `<textarea class="ans" rows="3" placeholder="先自己写一写你的答案…"></textarea><div class="row"><button class="btn primary" id="show">查看参考答案</button></div>`;
      $('#show', body).onclick = () => {
        body.innerHTML += `<div class="ref"><b>参考答案</b><br>${esc(q.reference)}</div><div class="row"><span class="muted">对照一下，你答得怎么样？</span><button class="btn" id="g1">基本答对</button><button class="btn" id="g0">没答好</button></div>`;
        $('#show', body).remove();
        $('#g1', body).onclick = () => complete(true, ''); $('#g0', body).onclick = () => complete(false, '');
      };
    }
  }
  function finish(){
    const ok = state.res.filter(r => r.ok).length;
    const byPiece = {};
    state.res.forEach(r => { const id = r.q.piece; (byPiece[id] = byPiece[id] || {ok:0,n:0}).n++; if (r.ok) byPiece[id].ok++;
      if (r.q.u !== undefined && r.q.kind !== 'author' && r.q.kind !== 'theme'){ r.ok ? clearWrong(id, r.q.u, r.q.kind) : recordWrong(id, r.q.u, r.q.kind); } });
    Object.entries(byPiece).forEach(([id, s]) => { addActivity(id, opts.act || 'quiz', s.ok, s.n); if (opts.srs !== false && s.n >= 2) applyReview(id, s.ok / s.n, opts.act || 'quiz'); });
    saveData();
    const wrong = state.res.filter(r => !r.ok);
    const pct = Math.round(ok/total*100);
    root.innerHTML = `<div class="result"><div class="score-ring" style="--p:${pct}"><b>${pct}%</b></div>
      <h2>${ok} / ${total} 题正确</h2><p class="muted">用时 ${Math.round((Date.now()-state.startedAt)/1000)} 秒 · 已记录到今天的学习日志${opts.srs!==false?'，并更新了复习计划':''}</p>
      ${wrong.length ? `<h3>需要加强（已加入错题本）</h3><ul class="wrong-list">${wrong.map(r => `<li><span class="chip">${esc(r.q.cat)}</span> ${r.q.prompt}${r.q.answer?`<div class="diff">${esc(r.q.answer)}</div>`:''}</li>`).join('')}</ul>` : '<p class="big-ok">全部答对，太棒了！🎉</p>'}
      <div class="row"><button class="btn primary" id="again">再来一组</button><a class="btn" href="#/progress">查看进度</a>${opts.backHref?`<a class="btn ghost" href="${opts.backHref}">返回</a>`:''}</div></div>`;
    $('#again', root).onclick = () => opts.again ? opts.again() : location.reload();
    opts.onFinish && opts.onFinish(state.res);
  }
  show();
}

