function openAuth(mode){
  const m = document.createElement('div'); m.className = 'modal';
  m.innerHTML = `<div class="dlg" role="dialog" aria-modal="true"><button class="x" aria-label="关闭">×</button>
    <div class="tabs"><button data-m="login" class="${mode==='login'?'on':''}">登录</button><button data-m="register" class="${mode==='register'?'on':''}">注册</button></div>
    <form id="authForm"><label>邮箱<input type="email" id="aEmail" required autocomplete="email"></label>
    <label>密码<input type="password" id="aPw" required minlength="6" autocomplete="${mode==='login'?'current-password':'new-password'}"></label>
    <p class="err" id="aErr"></p><button class="btn primary wide" type="submit">${mode==='login'?'登录':'注册并登录'}</button>
    <p class="muted small">账号与学习进度保存在本设备的浏览器中；换设备可在「账户」里导出/导入备份。</p></form></div>`;
  document.body.appendChild(m);
  const close = () => m.remove();
  $('.x', m).onclick = close; m.onclick = e => { if (e.target === m) close(); };
  $$('.tabs button', m).forEach(b => b.onclick = () => { close(); openAuth(b.dataset.m); });
  $('#aEmail', m).focus();
  $('#authForm', m).onsubmit = async e => {
    e.preventDefault();
    try {
      const em = $('#aEmail', m).value, pw = $('#aPw', m).value;
      if (mode === 'login') await Auth.login(em, pw); else await Auth.register(em, '', pw);
      close(); toast('欢迎，' + Session.user.username); renderHeader(); route();
    } catch(err){ $('#aErr', m).textContent = String(err.message || err); }
  };
}

/* —— 首页 —— */
function nextPiece(){
  const S = Session.data.settings; const pc = piecesOfGrade(S.grade);
  const lastId = (Object.values(Session.data.log).flatMap(l => l.acts).slice(-1)[0] || {}).id;
  const prefer = pc.filter(p => statusOf(p.id).k === 'learning')[0] || pc.filter(p => statusOf(p.id).k === 'new')[0] || pc[0];
  return prefer || getPiece(lastId) || allPieces()[0];
}
function openMethods(p){
  const m = document.createElement('div'); m.className = 'modal';
  const items = [['learn','📖','学习','原文、译文、注释、赏析'],['recite','🧠','背诵','分四级逐步脱稿'],['dict','✍️','默写 / 填空','上下句、理解性默写、排序'],['quiz','📝','解析题','字词、翻译、主旨、赏析']];
  m.innerHTML = `<div class="dlg wide"><button class="x" aria-label="关闭">×</button><h2>《${esc(p.title)}》怎么学？</h2><p class="muted">${esc(p.dynasty)}·${esc(p.author)} · ${esc(VOLS[p.volume]||'')}</p>
    <div class="methods">${items.map(([k,i,t,d]) => `<a class="method" href="#/piece/${p.id}/${k}"><span class="mi">${i}</span><b>${t}</b><small>${d}</small></a>`).join('')}
    <button class="method" id="mSpeak"><span class="mi">🔊</span><b>朗读</b><small>听一遍全文</small></button>
    <a class="method" href="#/practice"><span class="mi">🎯</span><b>综合练习</b><small>跨篇目混合出题</small></a></div></div>`;
  document.body.appendChild(m);
  m.onclick = e => { if (e.target === m || e.target.closest('.x') || e.target.closest('a.method')) m.remove(); };
  $('#mSpeak', m).onclick = () => speak(p.units.map(u => u.t).join(''));
}
function viewHome(){
  const S = Session.data.settings, L = dayLog(), due = dueList();
  const goalPct = Math.min(100, Math.round(((L.q) / S.goalQ * 0.6 + (L.sec/60) / S.goalMin * 0.4) * 100));
  const name = Session.user ? Session.user.username : '同学';
  const hour = new Date().getHours(); const hi = hour < 11 ? '早上好' : hour < 18 ? '下午好' : '晚上好';
  const all = allPieces(); const cnt = { new:0, learning:0, review:0, mastered:0 }; all.forEach(p => cnt[statusOf(p.id).k]++);
  const done = all.length - cnt.new, np = nextPiece();
  const volRows = Object.entries(VOLS).map(([v, nm]) => { const ps = all.filter(p => p.volume === v); if (!ps.length) return '';
    const m = ps.filter(p => statusOf(p.id).k === 'mastered').length, r = ps.filter(p => ['review','learning'].includes(statusOf(p.id).k)).length;
    return `<div class="vrow"><span>${nm}</span><div class="meter"><i class="m1" style="width:${m/ps.length*100}%"></i><i class="m2" style="width:${r/ps.length*100}%"></i></div><small class="muted">${m+r}/${ps.length}</small></div>`; }).join('');
  app().innerHTML = `
    <section class="hero"><div><h1>${hi}，${esc(name)}</h1>
      <p class="muted">${esc(gradeLabel(S.grade))} · ${today()} · 连续打卡 ${streak()} 天${S.targetDate ? ` · 距「${esc(S.goalNote||'目标')}」${Math.max(0,diffDays(today(), S.targetDate))} 天` : ''}</p>
      ${Session.user ? '' : '<p class="note">游客模式：进度保存在本机。<a href="#" id="hl">登录/注册</a>后可编辑头像、偏好与目标。</p>'}
      <div class="row big-actions"><a class="btn primary xl" href="#/piece/${np ? np.id : ''}/recite" id="goRecite">🧠 开始背诵</a><a class="btn xl" href="#/review">🔁 开始复习${due.length?`（${due.length}）`:''}</a></div></div>
      <div class="score-ring" style="--p:${goalPct}" title="今日目标完成度"><b>${goalPct}%</b><small>今日目标</small></div></section>
    <section class="card"><h2>整体教材进度</h2>
      <div class="row"><b class="big-num">${done}</b><span class="muted">/ ${all.length} 篇已学 · 已掌握 ${cnt.mastered} · 复习中 ${cnt.review} · 学习中 ${cnt.learning} · 未学 ${cnt.new}</span></div>
      <div class="stack">${[['mastered','已掌握'],['review','复习中'],['learning','学习中'],['new','未学']].map(([k,v]) => `<div class="seg st-${k}" style="flex:${cnt[k]||0.0001}">${cnt[k]?cnt[k]:''}</div>`).join('')}</div>
      <div class="vols">${volRows}</div><a class="btn" href="#/progress/mastery">查看详细进度</a></section>
    <section class="cols">
      <div class="card"><h2>接着学</h2>${np ? `<div class="next"><div><div class="pt">${esc(np.title)}</div><div class="muted">${esc(np.dynasty)}·${esc(np.author)} · ${esc(VOLS[np.volume]||'')}</div></div>${statusChip(np.id)}</div>
        <div class="row"><button class="btn primary" id="openM">打开 · 选择学习方式</button><a class="btn" href="#/library">全部篇目</a></div>` : '<p class="muted">还没有篇目。</p>'}</div>
      <div class="card"><h2>今日复习</h2>${due.length ? `<ul class="plain">${due.slice(0,4).map(p => `<li><a href="#/piece/${p.id}/recite">${esc(p.title)}</a> ${statusChip(p.id)}</li>`).join('')}</ul><a class="btn primary" href="#/review">复习 ${due.length} 篇</a>` : '<p class="muted">今天没有到期的复习。</p>'}</div></section>
    <section class="grid3">
      <div class="card stat"><span class="num">${L.q}</span><span>今日答题（目标 ${S.goalQ}）</span></div>
      <div class="card stat"><span class="num">${Math.round(L.sec/60)}</span><span>今日分钟（目标 ${S.goalMin}）</span></div>
      <div class="card stat"><span class="num">${Object.keys(Session.data.wrong).length}</span><span><a href="#/wrong">错题本条目</a></span></div></section>`;
  const hl = $('#hl'); if (hl) hl.onclick = e => { e.preventDefault(); openAuth('register'); };
  const om = $('#openM'); if (om) om.onclick = () => openMethods(np);
}

/* —— 篇目库 —— */
function viewLibrary(){
  const S = Session.data.settings; const q = { vol:'', kind:'', st:'', text:'' };
  const draw = () => {
    const g = GRADES.find(x => x.id === S.grade); const vols = g ? g.vols : Object.keys(VOLS);
    let list = piecesOfGrade(S.grade);
    if (q.vol) list = list.filter(p => p.volume === q.vol);
    if (q.kind) list = list.filter(p => p.kind === q.kind);
    if (q.st) list = list.filter(p => statusOf(p.id).k === q.st);
    if (q.text) list = list.filter(p => (p.title + p.author + p.units.map(u=>u.t).join('')).includes(q.text));
    $('#libList').innerHTML = list.length ? list.map(p => `<a class="pcard" href="#/piece/${p.id}">
        <div class="pt">${esc(p.title)}</div><div class="pa">${esc(p.dynasty)}·${esc(p.author)}</div>
        <div class="pm"><span class="chip">${p.kind==='poem'?'诗词':'文言文'}</span>${statusChip(p.id)}${isDue(p.id)?'<span class="st st-due">待复习</span>':''}</div>
        <div class="pv muted">${esc(VOLS[p.volume]||'自定义')} · ${p.units.length}句</div></a>`).join('') : '<div class="empty">这个范围里暂时没有篇目。</div>';
    $('#libCount').textContent = `共 ${list.length} 篇`;
  };
  const g = GRADES.find(x => x.id === S.grade); const vols = g ? g.vols : Object.keys(VOLS);
  app().innerHTML = `<h1>篇目库 · ${esc(gradeLabel(S.grade))}</h1>
    <div class="filters"><select id="fVol"><option value="">全部册别</option>${vols.map(v => `<option value="${v}">${VOLS[v]}</option>`).join('')}</select>
      <select id="fKind"><option value="">诗词 + 文言文</option><option value="poem">仅诗词</option><option value="prose">仅文言文</option></select>
      <select id="fSt"><option value="">全部状态</option><option value="new">未学</option><option value="learning">学习中</option><option value="review">复习中</option><option value="mastered">已掌握</option></select>
      <input id="fText" type="search" placeholder="搜索标题、作者、诗句"><span id="libCount" class="muted"></span>
      <button class="btn" id="addBtn">＋ 添加篇目</button></div><div id="libList" class="pgrid"></div>`;
  $('#fVol').onchange = e => { q.vol = e.target.value; draw(); }; $('#fKind').onchange = e => { q.kind = e.target.value; draw(); };
  $('#fSt').onchange = e => { q.st = e.target.value; draw(); }; $('#fText').oninput = e => { q.text = e.target.value.trim(); draw(); };
  $('#addBtn').onclick = openAddPiece; draw();
}
function openAddPiece(){
  const m = document.createElement('div'); m.className = 'modal';
  m.innerHTML = `<div class="dlg"><button class="x">×</button><h2>添加自定义篇目</h2>
    <form id="apForm"><label>标题<input id="apT" required></label><label>作者<input id="apA"></label><label>朝代<input id="apD" placeholder="如：唐"></label>
    <label>所属册别<select id="apV">${Object.entries(VOLS).map(([k,v]) => `<option value="${k}">${v}</option>`).join('')}</select></label>
    <label>类型<select id="apK"><option value="poem">诗词</option><option value="prose">文言文</option></select></label>
    <label>原文（每行一句或一联）<textarea id="apX" rows="6" required></textarea></label>
    <button class="btn primary wide">保存</button><p class="muted small">没有内置的篇目（如版权原因未收录的现代作品）可在这里自己录入，同样支持默写、填空和复习。</p></form></div>`;
  document.body.appendChild(m); $('.x', m).onclick = () => m.remove();
  $('#apForm', m).onsubmit = e => {
    e.preventDefault();
    let lines = $('#apX', m).value.split(/\n+/).map(s => s.trim().replace(/\s+/g,'')).filter(Boolean);
    if (lines.length === 1) lines = lines[0].match(/[^。！？；]+[。！？；]?/g) || lines;
    const p = { id:'c'+Date.now(), volume:$('#apV', m).value, title:$('#apT', m).value.trim(), author:$('#apA', m).value.trim()||'佚名', dynasty:$('#apD', m).value.trim(),
      genre:'自定义', kind:$('#apK', m).value, intro:'', theme:'', tags:[], units:lines.map(t => ({ t, tr:'', p:0, r:1 })), notes:[], tricky:[], keyLines:[], appr:[], custom:true };
    Session.data.custom.push(p); saveData(); m.remove(); toast('已添加'); go('#/piece/' + p.id);
  };
}

/* —— 篇目页 —— */
function markNotes(unit, notes){
  const flags = new Array(unit.t.length).fill(-1);
  notes.forEach((n,k) => { const s = unit.t.indexOf(n.w); if (s >= 0 && flags.slice(s, s+n.w.length).every(f => f < 0)) for (let j=s;j<s+n.w.length;j++) flags[j] = k; });
  let html = '', k = 0; const t = [...unit.t];
  while (k < t.length){
    if (flags[k] >= 0){ const id = flags[k]; let e = k; while (e < t.length && flags[e] === id) e++; const n = notes[id];
      html += `<mark title="${esc(n.m)}（${esc(n.t)}）">${esc(t.slice(k,e).join(''))}</mark>`; k = e; }
    else { html += esc(t[k]); k++; }
  }
  return html;
}
function speak(text){ try { speechSynthesis.cancel(); const u = new SpeechSynthesisUtterance(text.replace(/[“”‘’]/g,'')); u.lang = 'zh-CN'; u.rate = .8; speechSynthesis.speak(u); } catch(e){ toast('当前浏览器不支持朗读'); } }

function viewPiece(id, tab='learn'){
  const p = getPiece(id); if (!p){ app().innerHTML = '<div class="empty">找不到这篇课文。<a href="#/library">返回篇目库</a></div>'; return; }
  const pr = prog(id);
  app().innerHTML = `<div class="crumb"><a href="#/library">篇目库</a> / ${esc(VOLS[p.volume]||'自定义')}</div>
    <header class="ph"><div><h1>${esc(p.title)}</h1><p class="muted">${esc(p.dynasty)}·${esc(p.author)} · ${esc(p.genre||'')} ${statusChip(id)}${pr&&pr.due?` · 下次复习 ${pr.due}`:''}</p></div>
    <button class="btn" id="speakAll">🔊 朗读全文</button></header>
    <div class="tabs big" id="ptabs">${[['learn','学习'],['recite','背诵'],['dict','默写 / 填空'],['quiz','解析题']].map(([k,v]) => `<a href="#/piece/${id}/${k}" class="${k===tab?'on':''}">${v}</a>`).join('')}</div>
    <div id="ptab"></div>`;
  $('#speakAll').onclick = () => speak(p.units.map(u => u.t).join(''));
  const box = $('#ptab');
  if (tab === 'learn') pieceLearn(p, box); else if (tab === 'recite') pieceRecite(p, box);
  else if (tab === 'dict') pieceDict(p, box); else pieceQuiz(p, box);
}
function pieceLearn(p, box){
  let showTr = true; const paras = {};
  p.units.forEach((u,i) => (paras[u.p || 0] = paras[u.p || 0] || []).push(i));
  const draw = () => {
    box.innerHTML = `${p.intro ? `<div class="card soft"><b>背景</b>　${esc(p.intro)}</div>` : ''}
      <div class="row"><label class="switch"><input type="checkbox" id="trToggle" ${showTr?'checked':''}> 显示译文</label><span class="muted small">点击带下划线的词可看释义</span></div>
      <div class="text">${Object.values(paras).map(ix => `<div class="para">${ix.map(i => { const u = p.units[i];
        return `<div class="unit ${u.r===0?'dim':''}"><div class="ut"><button class="mini" data-s="${i}" title="朗读">🔊</button>${markNotes(u, (p.notes||[]).filter(n => n.u === i))}</div>${showTr && u.tr ? `<div class="tr">${esc(u.tr)}</div>` : ''}</div>`; }).join('')}</div>`).join('')}</div>
      ${p.units.some(u => u.r===0) ? '<p class="muted small">灰色部分不在要求背诵范围内，仍可阅读理解。</p>' : ''}
      ${p.theme ? `<div class="card soft"><b>主旨</b>　${esc(p.theme)}</div>` : ''}
      ${(p.notes||[]).length ? `<h3>重点字词</h3><table class="notes"><tr><th>词</th><th>释义</th><th>类型</th><th>出处</th></tr>${p.notes.map(n => `<tr><td><b>${esc(n.w)}</b></td><td>${esc(n.m)}</td><td>${esc(n.t)}</td><td class="muted">${esc(p.units[n.u].t)}</td></tr>`).join('')}</table>` : ''}
      ${(p.appr||[]).length ? `<h3>赏析思考</h3>${p.appr.map(a => `<details class="appr"><summary>${esc(a.q)}</summary><p>${esc(a.a)}</p></details>`).join('')}` : ''}
      <div class="row"><button class="btn primary" id="learned">✓ 我读懂了，加入复习计划</button><a class="btn" href="#/piece/${p.id}/recite">去背诵 →</a></div>`;
    $('#trToggle', box).onchange = e => { showTr = e.target.checked; draw(); };
    $$('.mini', box).forEach(b => b.onclick = () => speak(p.units[+b.dataset.s].t));
    $('#learned', box).onclick = () => { const pr = ensureProg(p.id); if (!pr.studied){ pr.studied = true; pr.box = 1; pr.due = addDays(today(), 1); } addActivity(p.id, 'learn', 0, 0); toast('已加入复习计划，明天复习'); renderHeader(); };
  };
  draw();
}
function pieceRecite(p, box){
  const R = reciteUnits(p); let level = Store.get('shici.level', 2); const rating = {}; const revealed = new Set();
  const hide = (t, i, lv) => {
    if (lv === 1 || revealed.has(i)) return esc(t);
    return [...t].map((c,k) => {
      if (!/[一-鿿]/.test(c)) return esc(c);
      if (lv === 2) return (p.tricky||[]).includes(c) || ((k*7 + i*3) % 4 === 0) ? '<span class="gap">＿</span>' : esc(c);
      if (lv === 3){ const cl = clauses(t); let pos = 0; for (const x of cl){ if (k < pos + x.length) return k === pos ? esc(c) : '<span class="gap">＿</span>'; pos += x.length; } }
      return '<span class="gap">＿</span>';
    }).join('');
  };
  const draw = () => {
    box.innerHTML = `<div class="row"><b>难度</b>${[[1,'① 看全文'],[2,'② 挖关键字'],[3,'③ 只看首字'],[4,'④ 全隐藏']].map(([k,v]) => `<button class="btn ${k===level?'primary':''}" data-l="${k}">${v}</button>`).join('')}</div>
      <p class="muted small">先出声背，再点击句子核对；每句选「记得 / 模糊 / 忘了」，系统会据此安排下次复习。</p>
      <div class="recite">${R.map(x => `<div class="rline ${rating[x.i]?'r-'+rating[x.i]:''}" data-i="${x.i}"><div class="rt" tabindex="0">${hide(x.t, x.i, level)}</div>
        ${revealed.has(x.i) && !rating[x.i] ? `<div class="rate"><button data-v="good">记得</button><button data-v="mid">模糊</button><button data-v="bad">忘了</button></div>` : ''}${revealed.has(x.i) && x.tr ? `<div class="tr">${esc(x.tr)}</div>` : ''}</div>`).join('')}</div>
      <div class="row"><span class="muted">已评 ${Object.keys(rating).length} / ${R.length} 句</span><button class="btn primary" id="finish" ${Object.keys(rating).length?'':'disabled'}>完成本轮背诵</button></div>`;
    $$('[data-l]', box).forEach(b => b.onclick = () => { level = +b.dataset.l; Store.set('shici.level', level); revealed.clear(); Object.keys(rating).forEach(k => delete rating[k]); draw(); });
    $$('.rline', box).forEach(el => { const i = +el.dataset.i; $('.rt', el).onclick = () => { if (!revealed.has(i)){ revealed.add(i); draw(); } };
      $$('.rate button', el).forEach(b => b.onclick = () => { rating[i] = b.dataset.v; draw(); }); });
    $('#finish', box).onclick = () => {
      const vals = Object.values(rating), n = vals.length; const good = vals.filter(v => v==='good').length, mid = vals.filter(v => v==='mid').length;
      const score = (good + mid*.5) / n;
      Object.entries(rating).forEach(([i,v]) => v === 'bad' ? recordWrong(p.id, +i, 'dict') : v === 'good' ? clearWrong(p.id, +i, 'dict') : 0);
      addActivity(p.id, 'recite', good, n); applyReview(p.id, score, 'recite'); renderHeader();
      box.innerHTML = `<div class="result"><div class="score-ring" style="--p:${Math.round(score*100)}"><b>${Math.round(score*100)}%</b></div><h2>记得 ${good} · 模糊 ${mid} · 忘了 ${n-good-mid}</h2>
        <p class="muted">下次复习：${prog(p.id).due}。${score<.6?'建议降一档难度再背一轮，然后去做默写。':score<.85?'再背一轮，然后用默写检验。':'很稳！去默写检验一下。'}</p>
        <div class="row"><a class="btn primary" href="#/piece/${p.id}/dict">去默写 →</a><button class="btn" id="redo">再背一轮</button></div></div>`;
      $('#redo', box).onclick = () => pieceRecite(p, box);
    };
  };
  draw();
}
function pieceDict(p, box){
  box.innerHTML = `<div class="row"><b>选择题型</b>
    <button class="btn primary" data-s="dict">上下句默写</button><button class="btn" data-s="key">理解性默写</button><button class="btn" data-s="fill">填空</button><button class="btn" data-s="order">句序排列</button><button class="btn" data-s="all">综合</button></div><div id="qroot" class="qroot"></div>`;
  const start = k => { const gens = k === 'all' ? QSETS.recite.gens : [k]; const run = () => runQuiz($('#qroot', box), buildQuestions([p], gens, 12), { act:'dict', again:run, backHref:`#/piece/${p.id}/recite` }); run(); };
  $$('[data-s]', box).forEach(b => b.onclick = () => { $$('[data-s]', box).forEach(x => x.classList.remove('primary')); b.classList.add('primary'); start(b.dataset.s); });
  start('dict');
}
function pieceQuiz(p, box){
  box.innerHTML = '<div id="qroot" class="qroot"></div>';
  const run = () => runQuiz($('#qroot', box), buildQuestions([p], 'analyze', 12), { act:'analyze', again:run, backHref:`#/piece/${p.id}` }); run();
}

/* —— 练习 —— */
function viewPractice(){
  const S = Session.data.settings; const g = GRADES.find(x => x.id === S.grade); const vols = g ? g.vols : Object.keys(VOLS);
  app().innerHTML = `<h1>练习</h1><div class="card"><div class="form-grid">
    <label>范围<select id="pScope"><option value="grade">${esc(gradeLabel(S.grade))}全部篇目</option>${vols.map(v => `<option value="${v}">${VOLS[v]}</option>`).join('')}<option value="learned">所有已学篇目</option><option value="due">今日待复习</option></select></label>
    <label>题型<select id="pSet"><option value="mixed">综合（解析 + 背诵）</option><option value="recite">背诵题（默写、填空、排序）</option><option value="analyze">解析题（字词、翻译、赏析、主旨）</option></select></label>
    <label>题数<select id="pN"><option>10</option><option selected>20</option><option>30</option></select></label>
    <label>只练<select id="pKind"><option value="">诗词 + 文言文</option><option value="poem">诗词</option><option value="prose">文言文</option></select></label></div>
    <button class="btn primary" id="pGo">开始练习</button></div><div id="qroot" class="qroot"></div>`;
  $('#pGo').onclick = () => {
    const sc = $('#pScope').value; let list;
    if (sc === 'grade') list = piecesOfGrade(S.grade); else if (sc === 'learned') list = allPieces().filter(p => statusOf(p.id).k !== 'new'); else if (sc === 'due') list = dueList(); else list = allPieces().filter(p => p.volume === sc);
    const k = $('#pKind').value; if (k) list = list.filter(p => p.kind === k);
    if (!list.length){ toast('这个范围里没有篇目（先学习几篇再来）'); return; }
    const run = () => { const qs = buildQuestions(pick(list, Math.min(list.length, 8)), $('#pSet').value, +$('#pN').value); $('#qroot').scrollIntoView({behavior:'smooth'}); runQuiz($('#qroot'), qs, { act:'practice', again:run }); };
    run();
  };
}

/* —— 复习 —— */
function viewReview(){
  const due = dueList(); const L = Session.data.progress;
  const up = {}; for (let i=0;i<14;i++) up[addDays(today(), i)] = 0;
  Object.values(L).forEach(p => { if (p.studied && p.due){ const d = p.due < today() ? today() : p.due; if (d in up) up[d]++; } });
  const max = Math.max(1, ...Object.values(up));
  app().innerHTML = `<h1>今日复习</h1><div class="card"><p>${due.length ? `有 <b>${due.length}</b> 篇到期。每篇会出 4–6 道默写/填空题，答对率决定下次间隔。` : '今天没有到期的复习。'}</p>
    <ul class="plain">${due.map(p => `<li><a href="#/piece/${p.id}">${esc(p.title)}</a> ${statusChip(p.id)}<span class="muted">应复习于 ${prog(p.id).due}，已复习 ${prog(p.id).reps} 次</span></li>`).join('')}</ul>
    ${due.length ? '<button class="btn primary" id="rvGo">开始复习</button>' : ''}</div>
    <div class="card"><h2>未来 14 天复习安排</h2><div class="mini-bars">${Object.entries(up).map(([d,n]) => `<div title="${d}：${n} 篇"><i style="height:${n/max*70+2}px"></i><small>${d.slice(5)}</small><b>${n||''}</b></div>`).join('')}</div>
    <p class="muted small">间隔：1 → 2 → 4 → 7 → 15 → 30 → 60 天。答对率≥85% 升一档；低于 60% 退两档并提前再见。</p></div><div id="qroot" class="qroot"></div>`;
  const go2 = $('#rvGo'); if (go2) go2.onclick = () => { const run = () => { const qs = []; due.forEach(p => buildQuestions([p], ['dict','fill','key','word'], 5).forEach(q => qs.push(q)));
      runQuiz($('#qroot'), shuffle(qs), { act:'review', again:() => { renderHeader(); viewReview(); } }); $('#qroot').scrollIntoView({behavior:'smooth'}); }; run(); };
}

/* —— 错题本 —— */
function viewWrong(){
  const W = Object.values(Session.data.wrong).filter(w => getPiece(w.id)); const by = {};
  W.forEach(w => (by[w.id] = by[w.id] || []).push(w));
  const KN = { dict:'默写', key:'理解性默写', fill:'填空', word:'字词', trans:'翻译', order:'排序', appr:'赏析' };
  app().innerHTML = `<h1>错题本</h1>${W.length ? `<div class="row"><button class="btn primary" id="wGo">练习全部错题（${W.length}）</button></div>` : '<div class="empty">还没有错题。答错或背诵时点「忘了」的句子会出现在这里。</div>'}
    ${Object.entries(by).map(([id, ws]) => { const p = getPiece(id); return `<div class="card"><h3><a href="#/piece/${id}">${esc(p.title)}</a> <span class="muted small">${ws.length} 处</span></h3>
      <ul class="plain">${ws.map(w => { const u = p.units[w.u]; return `<li><span class="chip">${KN[w.kind]||w.kind}</span>${u ? esc(u.t) : esc(w.kind)}<span class="muted">错 ${w.n} 次</span></li>`; }).join('')}</ul></div>`; }).join('')}<div id="qroot" class="qroot"></div>`;
  const b = $('#wGo'); if (b) b.onclick = () => {
    const run = () => { let qs = [];
      W.forEach(w => { const p = getPiece(w.id); const g = { dict:'dict', key:'key', fill:'fill', word:'word', trans:'trans', order:'order', appr:'appr' }[w.kind] || 'dict';
        qs = qs.concat(GENS[g](p).filter(q => q.u === w.u && q.kind === w.kind).slice(0,1)); });
      runQuiz($('#qroot'), shuffle(qs), { act:'wrong', again:() => viewWrong() }); $('#qroot').scrollIntoView({behavior:'smooth'}); }; run(); };
}

/* —— 进度（多个子页面） —— */
function viewProgress(sub='overview'){
  const subs = [['overview','总览'],['calendar','打卡日历'],['trend','趋势'],['mastery','掌握度'],['history','学习记录']];
  app().innerHTML = `<h1>学习进度</h1><div class="tabs big">${subs.map(([k,v]) => `<a href="#/progress/${k}" class="${k===sub?'on':''}">${v}</a>`).join('')}</div><div id="psub"></div>`;
  const box = $('#psub'); const T = totals(), L = Session.data.log, S = Session.data.settings;
  if (sub === 'overview'){
    const all = allPieces(); const cnt = { new:0, learning:0, review:0, mastered:0 }; all.forEach(p => cnt[statusOf(p.id).k]++);
    const acc = T.q ? Math.round(T.ok/T.q*100) : 0;
    box.innerHTML = `<div class="grid3"><div class="card stat"><span class="num">${streak()}</span><span>连续打卡</span></div><div class="card stat"><span class="num">${T.days}</span><span>累计学习天数</span></div>
      <div class="card stat"><span class="num">${Math.round(T.sec/60)}</span><span>累计分钟</span></div><div class="card stat"><span class="num">${T.q}</span><span>累计答题</span></div>
      <div class="card stat"><span class="num">${acc}%</span><span>总正确率</span></div><div class="card stat"><span class="num">${Object.keys(Session.data.wrong).length}</span><span>错题条目</span></div></div>
      <div class="card"><h2>篇目状态</h2><div class="stack">${[['mastered','已掌握'],['review','复习中'],['learning','学习中'],['new','未学']].map(([k,v]) => `<div class="seg st-${k}" style="flex:${cnt[k]||0.0001}" title="${v} ${cnt[k]}">${cnt[k]?`${v} ${cnt[k]}`:''}</div>`).join('')}</div></div>
      <div class="card"><h2>最需要加强的篇目</h2>${weakList()}</div>`;
  } else if (sub === 'calendar') calendarView(box);
  else if (sub === 'trend'){
    const days = []; for (let i=29;i>=0;i--) days.push(addDays(today(), -i));
    const qv = days.map(d => (L[d]||{q:0}).q), mv = days.map(d => Math.round(((L[d]||{sec:0}).sec)/60)), av = days.map(d => L[d] && L[d].q ? Math.round(L[d].ok/L[d].q*100) : null);
    box.innerHTML = `<div class="card"><h2>近 30 天答题数</h2>${barChart(days, qv, 'var(--c1)')}</div><div class="card"><h2>近 30 天学习分钟</h2>${barChart(days, mv, 'var(--c2)')}</div><div class="card"><h2>近 30 天正确率（%）</h2>${lineChart(days, av)}</div>`;
  } else if (sub === 'mastery'){
    box.innerHTML = Object.entries(VOLS).map(([v, name]) => { const ps = allPieces().filter(p => p.volume === v); if (!ps.length) return '';
      const m = ps.filter(p => statusOf(p.id).k === 'mastered').length, r = ps.filter(p => ['review','learning'].includes(statusOf(p.id).k)).length;
      return `<div class="card"><div class="row"><b>${name}</b><span class="muted">${m} 掌握 · ${r} 学习/复习 · 共 ${ps.length}</span></div><div class="meter"><i class="m1" style="width:${m/ps.length*100}%"></i><i class="m2" style="width:${r/ps.length*100}%"></i></div>
        <div class="chips">${ps.map(p => `<a href="#/piece/${p.id}" class="st st-${statusOf(p.id).k}" title="${esc(p.title)}">${esc(p.title.replace(/（.*/,''))}</a>`).join('')}</div></div>`; }).join('') || '<div class="empty">暂无数据</div>';
  } else {
    const ds = Object.keys(L).sort().reverse().slice(0, 30);
    box.innerHTML = ds.length ? ds.map(d => `<div class="card"><b>${d}</b> <span class="muted">答题 ${L[d].q}（对 ${L[d].ok}）· ${Math.round(L[d].sec/60)} 分钟</span>
      <ul class="plain">${L[d].acts.slice(-12).map(a => { const p = getPiece(a.id); return `<li>${a.t} ${({learn:'学习',recite:'背诵',dict:'默写',analyze:'解析题',practice:'练习',review:'复习',wrong:'错题'})[a.act]||a.act} · ${p?esc(p.title):''} ${a.n?`<span class="muted">${a.ok}/${a.n}</span>`:''}</li>`; }).join('')}</ul></div>`).join('') : '<div class="empty">还没有学习记录。</div>';
  }
}
function weakList(){
  const rows = allPieces().filter(p => prog(p.id) && prog(p.id).scores.length).map(p => { const s = prog(p.id).scores; return { p, last:s[s.length-1].s, lapses:prog(p.id).lapses }; }).sort((a,b) => a.last - b.last).slice(0,5);
  return rows.length ? `<ul class="plain">${rows.map(r => `<li><a href="#/piece/${r.p.id}/dict">${esc(r.p.title)}</a><span class="muted">最近得分 ${r.last}%${r.lapses?` · 遗忘 ${r.lapses} 次`:''}</span></li>`).join('')}</ul>` : '<p class="muted">做几组练习后，这里会列出得分最低的篇目。</p>';
}
function barChart(days, vals, color){
  const W = 640, H = 140, max = Math.max(1, ...vals), bw = W/days.length;
  return `<svg viewBox="0 0 ${W} ${H+22}" class="chart" role="img" aria-label="柱状图">${vals.map((v,i) => `<rect x="${i*bw+2}" y="${H-v/max*H}" width="${bw-4}" height="${v/max*H}" rx="2" fill="${color}"><title>${days[i]}：${v}</title></rect>`).join('')}
    <text x="0" y="${H+16}" class="ax">${days[0].slice(5)}</text><text x="${W}" y="${H+16}" text-anchor="end" class="ax">${days[days.length-1].slice(5)}</text><text x="${W}" y="10" text-anchor="end" class="ax">最高 ${max}</text></svg>`;
}
function lineChart(days, vals){
  const W = 640, H = 140, bw = W/days.length; const pts = vals.map((v,i) => v==null ? null : [i*bw+bw/2, H - v/100*H]).filter(Boolean);
  return `<svg viewBox="0 0 ${W} ${H+22}" class="chart" role="img" aria-label="折线图"><line x1="0" x2="${W}" y1="${H*.15}" y2="${H*.15}" class="grid"/><line x1="0" x2="${W}" y1="${H}" y2="${H}" class="grid"/>
    ${pts.length > 1 ? `<polyline fill="none" stroke="var(--c3)" stroke-width="2.5" points="${pts.map(p => p.join(',')).join(' ')}"/>` : ''}${pts.map(p => `<circle cx="${p[0]}" cy="${p[1]}" r="3.5" fill="var(--c3)"/>`).join('')}
    <text x="0" y="${H+16}" class="ax">${days[0].slice(5)}</text><text x="${W}" y="${H+16}" text-anchor="end" class="ax">${days[days.length-1].slice(5)}</text><text x="4" y="${H*.15-4}" class="ax">85%</text></svg>`;
}
function calendarView(box, ym){
  const now = new Date(); ym = ym || { y:now.getFullYear(), m:now.getMonth() }; const L = Session.data.log;
  const first = new Date(ym.y, ym.m, 1), nd = new Date(ym.y, ym.m+1, 0).getDate(); const off = (first.getDay()+6)%7;
  let cells = ''; for (let i=0;i<off;i++) cells += '<i></i>';
  for (let d=1; d<=nd; d++){ const k = `${ym.y}-${pad(ym.m+1)}-${pad(d)}`; const l = L[k]; const v = l ? l.q + l.sec/60 : 0; const lv = !v ? 0 : v < 5 ? 1 : v < 15 ? 2 : v < 30 ? 3 : 4;
    cells += `<button class="day lv${lv} ${k===today()?'today':''}" data-d="${k}" title="${k}">${d}</button>`; }
  box.innerHTML = `<div class="card"><div class="row"><button class="btn" id="pm">‹</button><b>${ym.y} 年 ${ym.m+1} 月</b><button class="btn" id="nm">›</button><span class="muted small">颜色越深，当天学得越多</span></div>
    <div class="cal"><b>一</b><b>二</b><b>三</b><b>四</b><b>五</b><b>六</b><b>日</b>${cells}</div><div id="dayDetail" class="muted">点击日期查看当天记录</div></div>`;
  $('#pm', box).onclick = () => calendarView(box, ym.m ? {y:ym.y, m:ym.m-1} : {y:ym.y-1, m:11});
  $('#nm', box).onclick = () => calendarView(box, ym.m < 11 ? {y:ym.y, m:ym.m+1} : {y:ym.y+1, m:0});
  $$('.day', box).forEach(b => b.onclick = () => { const l = L[b.dataset.d]; $('#dayDetail', box).innerHTML = l ? `<b>${b.dataset.d}</b>：答题 ${l.q}（对 ${l.ok}），${Math.round(l.sec/60)} 分钟；学习篇目：${l.pieces.map(id => { const p = getPiece(id); return p ? esc(p.title) : ''; }).join('、') || '无'}` : `${b.dataset.d}：没有记录`; });
}

/* —— 账户 —— */
function viewAccount(){
  const u = Session.user; if (!u){ app().innerHTML = '<div class="empty">请先登录。</div>'; openAuth('login'); return; }
  const S = Session.data.settings;
  app().innerHTML = `<h1>账户与偏好</h1>
    <div class="card"><h2>个人主页</h2><div class="prof"><div class="avbox">${avatarHtml(u, 'av big')}<label class="btn">上传头像<input type="file" id="avFile" accept="image/*" hidden></label>${u.avatar?'<button class="btn ghost" id="avDel">移除</button>':''}</div>
      <form id="pfForm" class="form-grid"><label>用户名<input id="pfName" value="${esc(u.username)}" required></label><label>邮箱（账号）<input id="pfEmail" type="email" value="${esc(u.email)}"></label>
      <label>修改邮箱需验证当前密码<input id="pfEmailPw" type="password" placeholder="仅修改邮箱时填写" autocomplete="current-password"></label><button class="btn primary">保存资料</button></form></div></div>
    <div class="card"><h2>学习偏好与目标</h2><form id="prefForm" class="form-grid">
      <label>默认年级<select id="sGrade">${GRADES.map(g => `<option value="${g.id}" ${g.id===S.grade?'selected':''}>${g.label}</option>`).join('')}<option value="all" ${S.grade==='all'?'selected':''}>全部</option></select></label>
      <label>每日答题目标<input type="number" id="sQ" min="5" max="200" value="${S.goalQ}"></label><label>每日学习分钟目标<input type="number" id="sMin" min="5" max="300" value="${S.goalMin}"></label>
      <label>学习侧重<select id="sFocus">${[['both','诗词 + 文言文'],['poem','侧重诗词'],['prose','侧重文言文']].map(([k,v]) => `<option value="${k}" ${S.focus===k?'selected':''}>${v}</option>`).join('')}</select></label>
      <label>目标日期（如期末考/中考）<input type="date" id="sDate" value="${esc(S.targetDate)}"></label><label>目标说明<input id="sNote" value="${esc(S.goalNote)}" placeholder="如：期末默写满分"></label>
      <button class="btn primary">保存偏好</button></form></div>
    <div class="card"><h2>修改密码</h2><form id="pwForm" class="form-grid"><label>当前密码<input type="password" id="pwOld" required autocomplete="current-password"></label><label>新密码（至少 6 位）<input type="password" id="pwNew" required minlength="6" autocomplete="new-password"></label><button class="btn">更新密码</button></form></div>
    <div class="card"><h2>数据备份</h2><p class="muted">进度保存在本设备的浏览器里。换电脑/手机时，先在旧设备导出，再在新设备登录后导入。</p>
      <div class="row"><button class="btn" id="exp">导出备份</button><label class="btn">导入备份<input type="file" id="imp" accept="application/json" hidden></label></div></div>
    <div class="card"><div class="row"><button class="btn" id="lo">退出登录</button><button class="btn danger" id="del">删除账号和数据</button></div></div>`;
  $('#avFile').onchange = e => { const f = e.target.files[0]; if (!f) return; const img = new Image(); const rd = new FileReader();
    rd.onload = () => { img.onload = () => { const c = document.createElement('canvas'), s = 160; c.width = c.height = s; const x = c.getContext('2d'); const m = Math.min(img.width, img.height);
      x.drawImage(img, (img.width-m)/2, (img.height-m)/2, m, m, 0, 0, s, s); Auth.updateProfile({ avatar:c.toDataURL('image/jpeg', .85) }); toast('头像已更新'); renderHeader(); viewAccount(); }; img.src = rd.result; }; rd.readAsDataURL(f); };
  const dv = $('#avDel'); if (dv) dv.onclick = () => { Auth.updateProfile({ avatar:'' }); renderHeader(); viewAccount(); };
  $('#pfForm').onsubmit = async e => { e.preventDefault(); try {
      const nn = $('#pfName').value.trim(); if (!nn) throw '用户名不能为空'; Auth.updateProfile({ username:nn });
      const ne = $('#pfEmail').value.trim().toLowerCase(); if (ne !== Session.user.email) await Auth.changeEmail(ne, $('#pfEmailPw').value);
      toast('资料已保存'); renderHeader(); } catch(err){ toast(String(err.message||err)); } };
  $('#prefForm').onsubmit = e => { e.preventDefault(); Object.assign(S, { grade:$('#sGrade').value, goalQ:+$('#sQ').value||20, goalMin:+$('#sMin').value||15, focus:$('#sFocus').value, targetDate:$('#sDate').value, goalNote:$('#sNote').value.trim() }); saveData(); renderHeader(); toast('偏好已保存'); };
  $('#pwForm').onsubmit = async e => { e.preventDefault(); try { await Auth.changePassword($('#pwOld').value, $('#pwNew').value); toast('密码已更新'); e.target.reset(); } catch(err){ toast(String(err.message||err)); } };
  $('#exp').onclick = () => { const blob = new Blob([JSON.stringify({ v:1, user:{ username:u.username, avatar:u.avatar }, data:Session.data }, null, 1)], { type:'application/json' }); const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = `shici-backup-${today()}.json`; a.click(); };
  $('#imp').onchange = e => { const f = e.target.files[0]; if (!f) return; const rd = new FileReader(); rd.onload = () => { try { const j = JSON.parse(rd.result); if (!j.data) throw 0; Session.data = Object.assign(newData(), j.data); saveData(); toast('已导入'); renderHeader(); viewAccount(); } catch(err){ toast('文件格式不正确'); } }; rd.readAsText(f); };
  $('#lo').onclick = () => { Auth.logout(); renderHeader(); go('#/home'); };
  $('#del').onclick = () => { if (confirm('确定删除账号和所有学习数据？此操作无法恢复。')){ Auth.deleteAccount(); renderHeader(); go('#/home'); } };
}

/* —— 兼容沙盒预览：不依赖浏览器原生表单提交 —— */
function submitForm(f){ if (!f || !f.onsubmit) return; if (f.checkValidity && !f.checkValidity()){ f.reportValidity && f.reportValidity(); return; } f.onsubmit({ preventDefault(){}, target:f }); }
document.addEventListener('click', e => { const b = e.target.closest && e.target.closest('form button'); if (b && (!b.type || b.type === 'submit')){ e.preventDefault(); submitForm(b.closest('form')); } });
document.addEventListener('keydown', e => { if (e.key === 'Enter' && e.target.matches && e.target.matches('form input')){ e.preventDefault(); submitForm(e.target.closest('form')); } });

/* ===== main: 路由与启动 ===== */
function route(){
  const parts = (HASH || '#/home').replace(/^#\/?/, '').split('/');
  const [r, a, b] = parts;
  window.scrollTo(0, 0);
  renderHeader();
  try {
    if (r === 'library') viewLibrary();
    else if (r === 'piece') viewPiece(decodeURIComponent(a||''), b || 'learn');
    else if (r === 'practice') viewPractice();
    else if (r === 'review') viewReview();
    else if (r === 'progress') viewProgress(a || 'overview');
    else if (r === 'wrong') viewWrong();
    else if (r === 'account') viewAccount();
    else viewHome();
  } catch(e){ console.error(e); app().innerHTML = `<div class="empty">页面出错了：${esc(e.message)}</div>`; }
}
Auth.restore();
startTimer();
route();


</script>
</body>
</html>
